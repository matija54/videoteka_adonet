<Window x:Class="videoteka_adonet.CustomerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uređivanje kupca" Height="300" Width="450">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">Ime:</TextBlock>
        <TextBox Grid.Row="0" Grid.Column="1" Name="txtFirstName" />

        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">Prezime:</TextBlock>
        <TextBox Grid.Row="1" Grid.Column="1" Name="txtLastName" />

        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">Članski broj:</TextBlock>
        <TextBox Grid.Row="2" Grid.Column="1" Name="txtMembership" />

        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Top">Adresa:</TextBlock>
        <TextBox Grid.Row="3" Grid.Column="1" Name="txtAddress" AcceptsReturn="True" Height="80" />

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Name="btnSave" Width="80" Margin="0,0,8,0" Click="btnSave_Click">Spremi</Button>
            <Button Width="80" Click="btnCancel_Click">Odustani</Button>
        </StackPanel>
    </Grid>
</Window>
