<Window x:Class="videoteka_adonet.FilmEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uređivanje filma" Height="300" Width="450">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">Šifra:</TextBlock>
        <TextBox Grid.Row="0" Grid.Column="1" Name="txtCode" />

        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">Naziv:</TextBlock>
        <TextBox Grid.Row="1" Grid.Column="1" Name="txtName" />

        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">Žanr:</TextBlock>
        <ComboBox Grid.Row="2" Grid.Column="1" Name="cbGenre" DisplayMemberPath="Name" SelectedValuePath="GenreId"/>

        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center">Količina:</TextBlock>
        <TextBox Grid.Row="3" Grid.Column="1" Name="txtQuantity" />

        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Top">Opis:</TextBlock>
        <TextBox Grid.Row="4" Grid.Column="1" Name="txtDescription" AcceptsReturn="True" Height="80" />

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Name="btnSave" Width="80" Margin="0,0,8,0" Click="btnSave_Click">Spremi</Button>
            <Button Width="80" Click="btnCancel_Click">Odustani</Button>
        </StackPanel>
    </Grid>
</Window>
