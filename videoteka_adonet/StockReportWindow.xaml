<Window x:Class="videoteka_adonet.StockReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stanje na skladištu" Height="500" Width="800">
    <DockPanel Margin="8">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">Žanrovi:</TextBlock>
            <ListBox Name="lbGenres" SelectionMode="Extended" Width="300" Height="120" />
            <Button Name="btnRun" Width="90" Margin="8,0,0,0" Click="btnRun_Click">Prikaži</Button>
        </StackPanel>

        <DataGrid Name="dgStock" AutoGenerateColumns="True" />
    </DockPanel>
</Window>
