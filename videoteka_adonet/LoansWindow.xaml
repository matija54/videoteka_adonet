<Window x:Class="videoteka_adonet.LoansWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Posudbe" Height="450" Width="800">
    <DockPanel Margin="8">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button Name="btnNew" Width="80" Margin="0,0,8,0" Click="btnNew_Click">Nova</Button>
            <Button Name="btnReturn" Width="80" Margin="0,0,8,0" Click="btnReturn_Click">Vrati</Button>
            <Button Name="btnDelete" Width="80" Click="btnDelete_Click">Obriši</Button>
        </StackPanel>

        <DataGrid Name="dgLoans" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="dgLoans_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="FilmId" Binding="{Binding FilmId}" Visibility="Collapsed" />
                <DataGridTextColumn Header="KupacId" Binding="{Binding KupacId}" Visibility="Collapsed" />
                <DataGridTextColumn Header="Šifra filma" Binding="{Binding Code}" />
                <DataGridTextColumn Header="Naziv" Binding="{Binding FilmName}" />
                <DataGridTextColumn Header="Kupac" Binding="{Binding CustomerName}" />
                <DataGridTextColumn Header="Datum posudbe" Binding="{Binding DatumPosudbe}" />
                <DataGridTextColumn Header="Datum vraćanja" Binding="{Binding DatumVracanja}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
