<Window x:Class="videoteka_adonet.LoanEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova posudba" Height="250" Width="450">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">Film:</TextBlock>
        <ComboBox Grid.Row="0" Grid.Column="1" Name="cbFilms" DisplayMemberPath="Display" SelectedValuePath="FilmId" />

        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">Kupac:</TextBlock>
        <ComboBox Grid.Row="1" Grid.Column="1" Name="cbCustomers" DisplayMemberPath="Display" SelectedValuePath="KupacId" />

        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">Datum posudbe:</TextBlock>
        <DatePicker Grid.Row="2" Grid.Column="1" Name="dpDate" SelectedDate="{x:Static sys:DateTime.Now}" xmlns:sys="clr-namespace:System;assembly=mscorlib" />

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Name="btnSave" Width="80" Margin="0,0,8,0" Click="btnSave_Click">Spremi</Button>
            <Button Width="80" Click="btnCancel_Click">Odustani</Button>
        </StackPanel>
    </Grid>
</Window>
